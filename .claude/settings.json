{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(.venv\\Scripts\\python.exe manage.py test scanner)",
      "Bash(.venv\\Scripts\\python.exe manage.py test scanner:*)",
      "Bash(.venv/Scripts/python.exe manage.py test scanner)",
      "Bash(.venv/Scripts/python.exe manage.py test scanner:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git clean:*)",
      "Bash(pip install:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(Invoke-WebRequest:*)",
      "Bash(rm:*)",
      "Bash(Remove-Item:*)"
    ]
  }
}
